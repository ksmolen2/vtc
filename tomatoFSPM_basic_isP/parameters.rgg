// =============================================================================
// CULTIVAR-SPECIFIC PARAMETERS
// =============================================================================

static double[] DELAY			= new double[totalSpecies];		// germination delay after start of simulation (in degreedays)

static double[] PHYLLOCHRON		= new double[totalSpecies];		// time between appearance of two PHYTOMERS (dd)
static int[] FINAL_VEG_PHYT_NUM	= new int[totalSpecies];			// final number of main stem vegetative phytomers

static double[] WMAX_ROOT		= new double[totalSpecies];		// maximum root system biomass
static double[] WMAX_FLOWER		= new double[totalSpecies];		// maximum flower/fruit biomass
static double[] WMAX_INT			= new double[totalSpecies];		// maximum internode biomass
static double[] WMAX_LEAF		= new double[totalSpecies];		// maximum leaf biomass
