static double[] TM_INT			= new double[totalSpecies];		// internode growth duration
static double[] TM_LEAF			= new double[totalSpecies];		// leaf growth duration

static double[] MAX_WIDTH_INT	= new double[totalSpecies];		// maximum internode width
static double[] K_WIDTH_INT		= new double[totalSpecies];		// k logistic function
static double[] TM_WIDTH_INT		= new double[totalSpecies];		// inflection point logistic function

static double[] MAX_LEN_INT		= new double[totalSpecies];		// maximum internode length
static double[] K_LEN_INT		= new double[totalSpecies];		// k logistic function
static double[] TM_LEN_INT		= new double[totalSpecies];		// inflection point logistic function

static double[] MAX_LEN_LEAF		= new double[totalSpecies];		// maximum leaf length
static double[] K_LEN_LEAF		= new double[totalSpecies];		// k logistic function
static double[] TM_LEN_LEAF		= new double[totalSpecies];		// inflection point logistic function

static double[] A_LEN_LEAF		= new double[totalSpecies];		// a power function (area-length relation)
static double[] G_LEN_LEAF		= new double[totalSpecies];		// g power function

static double[] MAX_AREA_LEAF	= new double[totalSpecies];		// maximum leaf area
static double[] K_AREA_LEAF		= new double[totalSpecies];		// k logistic function
static double[] TM_AREA_LEAF		= new double[totalSpecies];		// inflection point logistic function

static double[] AMAX				= new double[totalSpecies];		// max photosynthesis rate
static double[] EFF				= new double[totalSpecies];		// initial light use efficiency (initial slope of light response curve)
static double[] THETA 			= new double[totalSpecies];		// curvature
// lower level (up to rank 10 and including)
static double[] AMAX_LOWER		= new double[totalSpecies];		// max photosynthesis rate
static double[] EFF_LOWER		= new double[totalSpecies];		// initial light use efficiency (initial slope of light response curve)
static double[] THETA_LOWER 		= new double[totalSpecies];		// curvature
// upper level (rank 11 and above)
static double[] AMAX_UPPER		= new double[totalSpecies];		// max photosynthesis rate
static double[] EFF_UPPER		= new double[totalSpecies];		// initial light use efficiency (initial slope of light response curve)
static double[] THETA_UPPER 		= new double[totalSpecies];		// curvature

static double[] LW_RATIO			= new double[totalSpecies];		// ratio between leaf blade length and width
static double[] LW_RATIO_LF		= new double[totalSpecies];		// ratio between leaflet blade length and width
static double[] MAX_WIDTH		= new double[totalSpecies];		// location on the leaf where width is maximal (fraction of length)
static double[] K1_WIDTH			= new double[totalSpecies];		// parameter of getNormalizedLeafWidth2
static double[] K2_WIDTH			= new double[totalSpecies];		// parameter of getNormalizedLeafWidth2

