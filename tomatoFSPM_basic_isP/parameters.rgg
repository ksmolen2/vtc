static double[] TE_FLOWER		= new double[totalSpecies];		// flower/fruit growth duration
static double[] TE_INT			= new double[totalSpecies];		// internode growth duration
static double[] TE_LEAF			= new double[totalSpecies];		// leaf growth duration
