static double[] LEAF_ANGLE		= new double[totalSpecies];		// (calc acc Chen) max insertion angle of all leaves (90 = horizontal)
static double[] K_LEAF_ANGLE		= new double[totalSpecies];		// (calc acc Chen) k logistic function

static double[] LEAF_CURVE		= new double[totalSpecies];		// leaf curvature - angle between bottom and top of leaf blade (0 = flat)
static double[] K_LEAF_CURVE		= new double[totalSpecies];		// k logistic function
static double[] TM_LEAF_CURVE	= new double[totalSpecies];		// inflection point logistic function

