static float getDailyPARKaspro(int step)
{
	float par;
	int doyDataMax = LAST_DOY_DATA_KASPRO;
	
	int parCol = 22;
	
	if (dayOfYear < doyDataMax) {
		// par from data (umol/m2/s)
		println("par from data");
		if (climateDataDaily[step][parCol] != null && climateDataDaily[step][parCol].length() > 0) {
			par = Double.parseDouble(climateDataDaily[step][parCol]);
		} else {
			par = DR_FIXED;	// no values were measured
		}
	} else {
		// fixed par
		println("fixed par");
		par = DR_FIXED;
	}
	
	return par;
}