// LEAF 

module Leaf	extends VisibleOrgan {		
	
	double width;					// leaf width at widest point (m)
	double totalAreaBladeletSegm;	// area of leaf blade after segmentation
	double totalAreaSegm;			// area of leaf segments (petiole, rachis, petiolules)
	double totalLenSegm;				// actual leaf length (petiole + segm 1 + segm 2 + term leaflet)
	double normArea;					// normalized leaf area
	long segments;					// number of segments the leaf blade is composed of
	double angle;					// insertion angle of the leaf
	double bendingAngleSegment;		// bending angle per segment
	double bendingAngleSegment2;		// bending angle per segment
	
	int nrLfPairs;					// number of leaflet pairs (bladelets) on the next phytomer produced by the apex
	
	double petioleLength;			// length of a petiole (m)
	
	double lenSegment1;
	double lenSegment2;
		
	double lwR;
	double lwRlf;
	
	// leaf initiation
	void initiate(Apex a)
	{
		cultivar = a[cultivar];
		pb = a[pb];
		plantNumber = a[plantNumber];
		rank = a[rank];
		length = 0;
		wmax = WMAX_LEAF[cultivar];
		te = TE_LEAF[cultivar];
		tm = TM_LEAF[cultivar];
		
		lwR = LW_RATIO[cultivar];
		lwRlf = LW_RATIO_LF[cultivar];
		
		width = 0;
		totalAreaBladeletSegm = 0;
		totalAreaSegm = 0;
		totalLenSegm = 0; 
		normArea = calcFractionalArea(); // not used
	}
	
	void calcInverseRank() {
		rankInv = (pb[nbPhytomers] - rank) + 1;
			
	}
	
	// calculate dimensions
	void calcDimensions() {
		
		calcNrLeaflets();

		if (rank > 0) {
			
			// area
			double maxA = MAX_AREA_LEAF[cultivar];
			double kA = K_AREA_LEAF[cultivar];
			double tmA = TM_AREA_LEAF[cultivar];
			
			double rate_a = kA * maxA * Math.exp(-kA * (age - tmA));
			double rate_b = Math.exp(-kA * (age - tmA)) + 1;
			double rate = rate_a / Math.pow(rate_b, 2);
			double dt = age - agePrevious;
			area += (rate * dt) / 10000;
			
			// length (acc. Chen, 2014)
			double aAL = A_LEN_LEAF[cultivar];
			double gAL = G_LEN_LEAF[cultivar];
			length = Math.pow((area*10000)/aAL, 1.0/gAL) / 100;	// cm -> m
		}
		
		if (nrLfPairs == 1) {
			length *= 0.4;	// TODO
			petioleLength = length * 0.5;
		} else if (nrLfPairs == 2) {
			length *= 0.6;	// TODO
			petioleLength = length * 0.3;
		} else {
			petioleLength = length * PETIOLE_FRACTION[cultivar];
		}
		
		width = length / lwR;
		
	}
	
	// calculate frational area by integrating the leaf shape function in 100 steps of 0.01
	double calcFractionalArea() {
		double normArea = 0;
		for (double i = 0; i <= 1; i += 0.01) {
			normArea += getNormalizedLeafWidth(i,cultivar)*0.01;
		}
		return normArea;
	}
	
	// calculate the number of segments that the leaf is composed of
	void calcSegments() {
		segments = Math.max(MIN_SEGMENTS, Math.round(frBio * MAX_SEGMENTS));
	}
	
	// calculate leaf insertion angle
	void calcAngle() {
		
		// leaf angle as a function of its length
		double max = LEAF_ANGLE[cultivar];
		double k = K_LEAF_ANGLE[cultivar];
		angle = max * (1 - Math.exp(-k * length*100));	// simulated (m) -> measured length (cm)
		
		double maxS = LEAF_CURVE[cultivar] / segments;
		// hardcoded for 3 leaflet pairs + terminal leaflet
		double maxS2 = LEAF_CURVE[cultivar] / 4;
		double kC = K_LEAF_CURVE[cultivar];
		double tmC = TM_LEAF_CURVE[cultivar];
		
		bendingAngleSegment = maxS;
		bendingAngleSegment2 = maxS2;
		
	}
	
	// calculate the number of leaflets per leaf
	void calcNrLeaflets() {
		if (rank == 1) {
			nrLfPairs = 1;
		} else if (rank == 2) {
			nrLfPairs = 2;
		} else if (rank >= 3) {
			nrLfPairs = NR_LEAFLET_PAIRS[cultivar];
		}
	}
}
