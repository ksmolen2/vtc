// SEED 

// module for the reproductive organ
module Flower extends VisibleOrgan
{	
	double stl;					// truss ratio length / biomass (mm/mg) TODO: does this make sense??????
	double increment;			// length increment per time step
	int flno;					// number of flowers
	
	// flower initiation
	void initiate(Apex a)
	{
		cultivar = a[cultivar];
		pb = a[pb];
		plantNumber = a[plantNumber];
		rank = a[rank];
		length = 0;
		wmax = WMAX_FLOWER[cultivar];
		te = TE_FLOWER[cultivar];
		tm = TM_FLOWER[cultivar];
		stl = 0.04 * 0.2 / 1000;	// todo temp
		flno = FLNO_MERLICE;
	}
	
	// calculate dimensions
	void calcDimensions()
	{
		increment = stl * growth;
		length += increment;
	}
}                             
