// =============================================================================
// SEED 

module Seed extends Sphere(0.001)
{
	int cultivar;					// plant cultivar
	PlantBase pb;					// plant to which the seed belongs
	int plantNumber;					// plant number in the field
	double endo;						// endosperm biomass (mg)
	double germinationDelay;			// delay before gemination takes place
	
	// seed initiation
	void initiate(int cultivar, PlantBase pb, int i)
	{
		this.cultivar = cultivar;
		this.pb = pb;
		plantNumber = i;
		endo = SEED_MASS[cultivar];
		germinationDelay = DELAY[cultivar];
	}
	
	// conditions for germinations
	boolean shouldEmerge(PlantBase pb) {
		return (pb[age] >= germinationDelay);
	}
}


// =============================================================================
// ROOT 

// root sink module when root system is not explicitly simulated 
module RootSystem extends GrowingOrgan
{
	// root initiation
	void initiate(PlantBase pb)
	{
		cultivar = pb[cultivar];
		this.pb = pb;
		plantNumber = pb[plantNumber];
		length = 0;
		wmax = WMAX_ROOT[cultivar];
		te = TE_ROOT[cultivar];
		tm = te / 2;
	}
}


// =============================================================================
// APEX 

// apex module, represents the apical meristem that produces new phytomers
module Apex extends Organ
{
	int numberVegPhyt;				// number of leaves (vegetative phytomers) to produce
	int nrLeaves;					// number of leaves on the next phytomer produced by the apex
	double phylloAngle;				// phyllotactic angle for the next phytomer
	
	// initiation of main apex
	void initiate(PlantBase pb)
	{
		this.pb = pb;
		cultivar = pb[cultivar];
		plantNumber = pb[plantNumber];
		rank = 0;
		numberVegPhyt = FINAL_VEG_PHYT_NUM[cultivar];
		nrLeaves = 1;
		phylloAngle = PHYLLOTAXIS[cultivar];
		
	}
	
	// increase in identifiers after phytomer creation
	void increment()
	{
		rank = rank + 1;
	}
		
	// conditions for vegetative phytomer productions
	boolean shouldProduceVegetative() {                  
		if (rank <= numberVegPhyt && age >= rank * phyllochr) {
			return true;	
		}
	}
	
	// conditions fot reproductive phytomer production
	boolean shouldProduceGenerative()
	{
		if (rank > numberVegPhyt && age >= rank * phyllochr) {
			pb[flowering] = true; 
			return true;
		}                                                          
	} 	
}
// buds are visualized as spheres
