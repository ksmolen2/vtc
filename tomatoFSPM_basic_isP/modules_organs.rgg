// =============================================================================
// INTERNODE 

module Internode extends VisibleOrgan {
	
	double width;						// internode width/diameter (m)
	double sil;							// stem ratio length / biomass (mm/mg)
	double increment;					// length increment per time step
	
	// internode initiation
	void initiate(Apex a) {
		cultivar = a[cultivar];
		pb = a[pb];
		plantNumber = a[plantNumber];
		rank = a[rank];
		length = 0;
		wmax = WMAX_INT[cultivar];
		te = TE_INT[cultivar];
		tm = TM_INT[cultivar];
	}
	
	void calcInverseRank() {
		rankInv = (pb[nbPhytomers] - rank) + 1;
	}
	
	// calculate dimensions
	void calcDimensions()
	{
		if (rank > 0) {
			
			double maxL = MAX_LEN_INT[cultivar];
			double kL = K_LEN_INT[cultivar];
			double tmL = TM_LEN_INT[cultivar];
			
			// elongation rate
			double rate_a = kL * maxL * Math.exp(-kL * (age - tmL));
			double rate_b = Math.exp(-kL * (age - tmL)) + 1;
			double rate = rate_a / Math.pow(rate_b, 2);
			double dt = age - agePrevious;
			length += rate * dt;
		}
		double maxW = MAX_WIDTH_INT[cultivar];
		double kW = K_WIDTH_INT[cultivar];
		double tmW = TM_WIDTH_INT[cultivar];
		width = maxW / (1 + Math.exp(-kW * (age - tmW)));
		
		area = 2 * Math.PI * 0.5*width * length;          
	}
}
// internodes are visualized as cylinders
