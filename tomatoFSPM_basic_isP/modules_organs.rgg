// calculate leaf shape as the normalized width along the midrib, Coussement et al., simplified
static double getNormalizedLeafWidth(float lnorm, int cultivar) {
	
	double k1 = K1_WIDTH[cultivar];
	double k2 = K2_WIDTH[cultivar];
	
	double gL = 0;
	
	if (lnorm <= MAX_WIDTH[cultivar]) {
		gL = 1 - Math.pow((MAX_WIDTH[cultivar] - lnorm)/MAX_WIDTH[cultivar],k1);	
	} else {
		gL = 1 - Math.pow((lnorm - MAX_WIDTH[cultivar])/(1 - MAX_WIDTH[cultivar]),k2);
	}
	
	return gL;
}


// =============================================================================
// LEAFLET 

module Leaflet(int cultivar, int rank, int rankInv, long segments, float length, double width, double bendingAngleSegment)
{	
	double getAreaSegm() {
		
		double segmArea = 0;
		
		for (int i=1; i < segments; i++) {
			double segmentLength = length/segments;
			double segmentWidth = 0.5*width * getNormalizedLeafWidth(1 - (double)i/segments, cultivar);
			segmArea += segmentLength*2*segmentWidth;
		}
		
		return segmArea;
	}
	
	protected Shader getOrganShader() {
		return getMeasOP();
	}
	
	protected Shader getMeasOP() {
		// simple model
		if (simpleModelOP) {
			return MERLICE_AVG_U_AS;
			
		// complex model (two layers)
		} else {
			// lower layer
			if (rankInv >= THRESHOLD_RANK) {	// top > bottom counting
				return MERLICE_AVG_L_AS;
				
			// upper layer
			} else {
				return MERLICE_AVG_U_AS;
			}
		}
	}
} ==> 
